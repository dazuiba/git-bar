{
  "name": "git-bar",
  "version": "0.1.1",
  "description": "Terminal daily git activity bars grouped by date and author, with per-author colors.",
  "type": "module",
  "bin": {
    "git-bar": "dist/git-bar.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "node --experimental-strip-types src/git-bar.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "git",
    "git stats",
    "git calendar",
    "git activity",
    "git contributions",
    "git commits per day",
    "cli",
    "bar",
    "commit",
    "visualization"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "author": {
    "name": "Sam Zhang"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.7.2"
  }
}
